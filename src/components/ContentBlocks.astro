---
import type { MarkdownInstance } from "astro";

const { kind, slug } = Astro.props as { kind: "log" | "projects"; slug: string };
const documents = import.meta.glob<MarkdownInstance<{ slug?: string }>>(
  "../../content/{log,projects}/*.md",
  { eager: true },
);
const document = Object.entries(documents).find(([path, entry]) => {
  const [directory, filename] = path.split("/").slice(-2);
  return directory === kind && (entry.frontmatter.slug ?? filename.slice(0, -3)) === slug;
})?.[1];
if (!document) throw new Error(`Missing Markdown for ${kind}/${slug}`);
const { Content } = document;
---

<div class="content-blocks">
  <Content />
</div>
