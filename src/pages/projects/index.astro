---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects } from "../../site";
---

<BlogPostLayout
  frontmatter={{
    title: "Projects",
    description: "Long-running threads of work: sensing, signal processing, wireless systems and standards.",
  }}
>
  <ul class="card-list">
    {projects().map((project) => <ProjectCard project={project} heading="h2" />)}
  </ul>
</BlogPostLayout>
