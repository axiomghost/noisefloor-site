---
import { fileContent } from "../../content.generated";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import ContentBlocks from "../../components/ContentBlocks.astro";

export function getStaticPaths() {
  return fileContent.projects.filter((project) => project.published).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const entries = fileContent.entries
  .filter((entry) => entry.published && entry.project_id === project.id)
  .sort((a, b) => (b.published_at ?? "").localeCompare(a.published_at ?? ""));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BlogPostLayout frontmatter={{ title: project.name, description: project.summary, tags: project.tags }}>
  <p class="post-meta">&gt; project // {project.status}</p>
  <ContentBlocks kind="projects" slug={project.slug} />
  {entries.length > 0 && (
    <section aria-labelledby="project-diary">
      <h2 id="project-diary">Project diary</h2>
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={`${base}/log/${entry.slug}/`}>{entry.title}</a>
            {entry.summary && <p>{entry.summary}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}
</BlogPostLayout>
