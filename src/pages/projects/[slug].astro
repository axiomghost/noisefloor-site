---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import ContentBlocks from "../../components/ContentBlocks.astro";
import EntryCard from "../../components/EntryCard.astro";
import { href, entries, projects, humanize } from "../../site";

export function getStaticPaths() {
  return projects().map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const diary = entries().filter((entry) => entry.project_id === project.id);
---

<BlogPostLayout
  frontmatter={{ title: project.name, description: project.summary, tags: project.tags }}
  eyebrow={{ label: `Project · ${humanize(project.status ?? "active")}`, href: href("/projects/") }}
>
  <ContentBlocks kind="projects" slug={project.slug} />
  {diary.length > 0 && (
    <section aria-labelledby="project-diary">
      <h2 id="project-diary">Diary entries</h2>
      <ul class="card-list">
        {diary.map((entry) => <EntryCard entry={entry} />)}
      </ul>
    </section>
  )}
</BlogPostLayout>
