---
import SiteLayout from "../layouts/SiteLayout.astro";
import EntryCard from "../components/EntryCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { href, entries, projects } from "../site";

const latest = entries().slice(0, 6);
const work = projects();
---

<SiteLayout>
  <section class="hero">
    <p class="eyebrow">noise-floor · engineering notes</p>
    <h1 class="page-title">Field notes for code, systems, and the things that break in interesting ways.</h1>
    <p class="page-lede">
      A public notebook from the edge between signal processing, embedded systems and software
      infrastructure: acoustic localization experiments, digital twin prototypes and 3GPP tooling,
      with the maths, the code and the parts that do not work yet.
    </p>
    <div class="hero-links">
      <a class="button primary" href={href("/log/")}>Read the diary</a>
      <a class="button" href={href("/projects/")}>Projects</a>
      <a class="button" href={href("/about/")}>About</a>
    </div>
  </section>

  <div class="section-head">
    <h2>Latest notes</h2>
    <a href={href("/log/")}>All entries →</a>
  </div>
  {latest.length > 0 ? (
    <ul class="card-grid">{latest.map((entry) => <EntryCard entry={entry} />)}</ul>
  ) : (
    <p>No public posts yet.</p>
  )}

  <div class="section-head">
    <h2>Projects</h2>
    <a href={href("/projects/")}>All projects →</a>
  </div>
  <ul class="card-grid">{work.map((project) => <ProjectCard project={project} />)}</ul>
</SiteLayout>
