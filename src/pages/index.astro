---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate?.getTime() ?? 0;
    const bTime = b.data.pubDate?.getTime() ?? 0;
    return bTime - aTime;
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>noise-floor</title>
    <meta
      name="description"
      content="Publication target for technical writing packaged from the OpenClaw workspace."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #040505;
        --bg-haze: rgba(71, 126, 95, 0.12);
        --bg-haze-2: rgba(92, 132, 118, 0.08);
        --panel: rgba(8, 10, 10, 0.86);
        --panel-soft: rgba(10, 12, 12, 0.78);
        --border: rgba(89, 122, 104, 0.34);
        --border-strong: rgba(134, 193, 157, 0.4);
        --text: #d8dedb;
        --muted: #8b9891;
        --signal: #86c19d;
        --signal-strong: #b9e0c7;
        --signal-dim: #5d7f6a;
        --accent: #78a8a1;
        --accent-2: #7fa9c7;
        --shadow: rgba(0, 0, 0, 0.42);
        font-family: "IBM Plex Mono", "Courier New", monospace;
        line-height: 1.7;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 18% 16%, var(--bg-haze), transparent 22%),
          radial-gradient(circle at 72% 10%, var(--bg-haze-2), transparent 18%),
          radial-gradient(circle at 50% 85%, rgba(120, 168, 161, 0.05), transparent 26%),
          radial-gradient(circle at 78% 76%, rgba(127, 169, 199, 0.06), transparent 18%),
          linear-gradient(120deg, transparent 0%, rgba(134, 193, 157, 0.035) 24%, transparent 48%),
          linear-gradient(60deg, transparent 0%, rgba(120, 168, 161, 0.03) 28%, transparent 52%),
          linear-gradient(28deg, transparent 0%, rgba(127, 169, 199, 0.028) 30%, transparent 54%),
          var(--bg);
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-radial-gradient(
            circle at 15% 20%,
            rgba(134, 193, 157, 0.055) 0 1px,
            transparent 1px 28px
          ),
          repeating-radial-gradient(
            circle at 80% 30%,
            rgba(120, 168, 161, 0.04) 0 1px,
            transparent 1px 34px
          ),
          repeating-radial-gradient(
            circle at 62% 74%,
            rgba(127, 169, 199, 0.032) 0 1px,
            transparent 1px 40px
          );
        filter: blur(14px);
        opacity: 0.55;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 24%, transparent 0 84px, rgba(134, 193, 157, 0.05) 84px 86px, transparent 86px 116px, rgba(134, 193, 157, 0.035) 116px 118px, transparent 118px),
          radial-gradient(circle at 72% 28%, transparent 0 112px, rgba(127, 169, 199, 0.04) 112px 114px, transparent 114px 150px, rgba(127, 169, 199, 0.028) 150px 152px, transparent 152px),
          radial-gradient(circle at 58% 78%, transparent 0 96px, rgba(120, 168, 161, 0.032) 96px 98px, transparent 98px 132px, rgba(120, 168, 161, 0.022) 132px 134px, transparent 134px);
        filter: blur(10px);
        opacity: 0.68;
      }

      main {
        max-width: 88rem;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
        position: relative;
        z-index: 1;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .masthead {
        margin-bottom: 2.5rem;
        padding: 1.5rem 1.6rem;
        border: 1px solid var(--border-strong);
        background:
          linear-gradient(180deg, rgba(10, 12, 12, 0.92), rgba(8, 10, 10, 0.8)),
          var(--panel);
        box-shadow:
          0 18px 46px var(--shadow),
          0 0 0 1px rgba(127, 169, 199, 0.05),
          0 0 28px rgba(134, 193, 157, 0.08);
        border-radius: 0;
      }

      .kicker,
      .meta,
      .post-meta,
      .empty {
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .kicker {
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.76rem;
        margin: 0 0 0.9rem;
      }

      h1,
      h2 {
        line-height: 1.22;
      }

      h1 {
        font-size: clamp(1.7rem, 3.3vw, 2.6rem);
        margin: 0;
        max-width: 26ch;
        color: var(--signal-strong);
        font-weight: 600;
      }

      .lede {
        max-width: 72rem;
        color: var(--muted);
        font-size: 0.98rem;
        margin: 1rem 0 0;
      }

      .meta {
        margin-top: 1.25rem;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .section-title {
        margin: 2rem 0 1rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.84rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
        gap: 1rem;
      }

      .post-card {
        padding: 1.15rem 1.2rem 1.2rem;
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(12, 15, 14, 0.92), rgba(9, 11, 11, 0.84)),
          var(--panel-soft);
        border-radius: 0;
        box-shadow:
          0 14px 34px rgba(0, 0, 0, 0.2),
          0 0 18px rgba(134, 193, 157, 0.04);
      }

      .post-card h2 {
        margin: 0 0 0.4rem;
        font-size: 1.02rem;
        font-weight: 500;
      }

      .post-card p {
        margin: 0.45rem 0;
      }

      .post-meta {
        color: var(--muted);
        font-size: 0.84rem;
      }

      .post-card:nth-child(2n) .post-meta {
        color: color-mix(in srgb, var(--muted) 76%, var(--accent-2) 24%);
      }

      .empty {
        margin-top: 0;
        color: var(--muted);
      }

      .sigil {
        color: var(--signal);
        margin-right: 0.45rem;
      }

      @media (max-width: 720px) {
        main {
          padding: 1.5rem 0.9rem 3rem;
        }

        .masthead {
          padding: 1.15rem 1rem;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(1.45rem, 6.5vw, 2rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="masthead">
        <p class="kicker">noise-floor // journal index</p>
        <h1>Field notes for code, systems, and the things that break in interesting ways.</h1>
        <p class="lede">
          A sparse technical journal with clean edges, quiet contrast, and just
          enough green signal in the dark. Source truth stays in the workspace
          until a post is intentionally packaged here.
        </p>
        <p class="meta">status: online · layout: boxed · theme: monochrome-signal</p>
      </section>

      <p class="section-title">Published Notes</p>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-card">
                <p class="post-meta">
                  <span class="sigil">&gt;</span>
                  {post.data.pubDate?.toISOString().slice(0, 10) ?? "undated"}
                  {post.data.tags.length > 0 && ` // ${post.data.tags.join(" · ")}`}
                </p>
                <h2>
                  <a href={`${baseUrl}blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.thesis && <p class="post-meta">thesis: {post.data.thesis}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No public posts yet.</p>
        )
      }
    </main>
  </body>
</html>
