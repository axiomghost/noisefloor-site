---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate?.getTime() ?? 0;
    const bTime = b.data.pubDate?.getTime() ?? 0;
    return bTime - aTime;
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>noise-floor</title>
    <meta
      name="description"
      content="Publication target for technical writing packaged from the OpenClaw workspace."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #050507;
        --bg-haze: rgba(0, 229, 255, 0.08);
        --bg-haze-2: rgba(255, 51, 102, 0.05);
        --bg-haze-3: rgba(0, 255, 159, 0.04);
        --panel: rgba(8, 8, 14, 0.9);
        --panel-soft: rgba(10, 10, 16, 0.82);
        --border: rgba(0, 229, 255, 0.18);
        --border-strong: rgba(0, 229, 255, 0.35);
        --text: #e4e8ef;
        --muted: #6b7a8a;
        --signal: #00e5ff;
        --signal-strong: #66ffee;
        --signal-dim: #0099aa;
        --accent: #ff1744;
        --accent-2: #ffaa2c;
        --accent-3: #00ff9f;
        --shadow: rgba(0, 0, 0, 0.5);
        font-family: "JetBrains Mono", "Courier New", monospace;
        line-height: 1.7;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 15% 12%, var(--bg-haze), transparent 28%),
          radial-gradient(circle at 75% 8%, var(--bg-haze-2), transparent 22%),
          radial-gradient(circle at 50% 80%, var(--bg-haze-3), transparent 30%),
          radial-gradient(circle at 85% 70%, rgba(255, 170, 44, 0.03), transparent 20%),
          linear-gradient(135deg, transparent 0%, rgba(0, 229, 255, 0.03) 20%, transparent 45%),
          linear-gradient(45deg, transparent 0%, rgba(255, 51, 102, 0.02) 25%, transparent 50%),
          linear-gradient(200deg, transparent 0%, rgba(0, 255, 159, 0.02) 30%, transparent 55%),
          var(--bg);
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-radial-gradient(
            circle at 12% 18%,
            rgba(0, 229, 255, 0.04) 0 1px,
            transparent 1px 30px
          ),
          repeating-radial-gradient(
            circle at 82% 25%,
            rgba(255, 51, 102, 0.025) 0 1px,
            transparent 1px 36px
          ),
          repeating-radial-gradient(
            circle at 55% 72%,
            rgba(0, 255, 159, 0.02) 0 1px,
            transparent 1px 42px
          );
        filter: blur(12px);
        opacity: 0.6;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 22%, transparent 0 80px, rgba(0, 229, 255, 0.04) 80px 82px, transparent 82px 120px, rgba(0, 229, 255, 0.025) 120px 122px, transparent 122px),
          radial-gradient(circle at 75% 30%, transparent 0 100px, rgba(255, 51, 102, 0.03) 100px 102px, transparent 102px 145px, rgba(255, 51, 102, 0.018) 145px 147px, transparent 147px),
          radial-gradient(circle at 55% 75%, transparent 0 90px, rgba(0, 255, 159, 0.025) 90px 92px, transparent 92px 130px, rgba(0, 255, 159, 0.015) 130px 132px, transparent 132px);
        filter: blur(10px);
        opacity: 0.7;
      }

      main {
        max-width: 88rem;
        margin: 0 auto;
        padding: 3rem 2rem 5rem;
        position: relative;
        z-index: 1;
      }

      a {
        color: var(--signal);
        text-decoration: none;
        transition: color 0.2s;
      }

      a:hover {
        color: var(--signal-strong);
        text-decoration: underline;
      }

      .masthead {
        margin-bottom: 2.5rem;
        padding: 2rem 2rem 1.8rem;
        border: 1px solid var(--border-strong);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.85)),
          var(--panel);
        box-shadow:
          0 20px 50px var(--shadow),
          0 0 0 1px rgba(0, 229, 255, 0.06),
          0 0 40px rgba(0, 229, 255, 0.06),
          0 0 80px rgba(255, 51, 102, 0.03);
        border-radius: 0;
        position: relative;
        overflow: hidden;
      }

      /* NF watermark behind masthead */
      .masthead::before {
        content: "";
        position: absolute;
        top: -20px;
        right: -10px;
        width: 220px;
        height: 260px;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 52 52' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='0' y='0' width='7' height='52' fill='%23ff1744'/%3E%3Cpolygon points='0,0 9,0 28,44 28,52 19,52 0,8' fill='%23ff1744'/%3E%3Crect x='23' y='0' width='5' height='52' fill='%23ff1744'/%3E%3Crect x='28' y='0' width='5' height='52' fill='%2300e5ff'/%3E%3Crect x='33' y='0' width='17' height='9' fill='%2300e5ff'/%3E%3Crect x='33' y='22' width='14' height='9' fill='%2300e5ff'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-size: contain;
        opacity: 0.045;
        pointer-events: none;
      }

      .nf-logo {
        display: inline-block;
        width: 38px;
        height: 44px;
        vertical-align: middle;
        margin-right: 0.6rem;
        position: relative;
        top: -2px;
      }

      .kicker,
      .meta,
      .post-meta,
      .empty {
        font-family: "JetBrains Mono", "Courier New", monospace;
      }

      .kicker {
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.76rem;
        margin: 0 0 0.9rem;
        display: flex;
        align-items: center;
      }

      h1,
      h2 {
        font-family: "Space Grotesk", "Arial", sans-serif;
        line-height: 1.22;
      }

      h1 {
        font-size: clamp(1.7rem, 3.3vw, 2.6rem);
        margin: 0;
        max-width: 26ch;
        color: var(--signal-strong);
        font-weight: 700;
      }

      .lede {
        max-width: 72rem;
        color: var(--muted);
        font-size: 0.95rem;
        margin: 1rem 0 0;
      }

      .meta {
        margin-top: 1.25rem;
        color: var(--muted);
        font-size: 0.8rem;
      }

      .meta .status-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: var(--accent-3);
        border-radius: 50%;
        margin-right: 0.4rem;
        box-shadow: 0 0 6px var(--accent-3);
        animation: pulse-dot 2.5s ease-in-out infinite;
      }

      @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--accent-3); }
        50% { opacity: 0.5; box-shadow: 0 0 2px var(--accent-3); }
      }

      .section-title {
        margin: 2rem 0 1rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.84rem;
        font-family: "JetBrains Mono", "Courier New", monospace;
      }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
        gap: 1rem;
      }

      .post-card {
        padding: 1.15rem 1.2rem 1.2rem;
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(10, 10, 16, 0.94), rgba(7, 7, 12, 0.86)),
          var(--panel-soft);
        border-radius: 0;
        box-shadow:
          0 14px 34px rgba(0, 0, 0, 0.25),
          0 0 20px rgba(0, 229, 255, 0.03);
        transition: border-color 0.25s, box-shadow 0.25s;
      }

      .post-card:hover {
        border-color: var(--border-strong);
        box-shadow:
          0 14px 34px rgba(0, 0, 0, 0.3),
          0 0 30px rgba(0, 229, 255, 0.06);
      }

      .post-card h2 {
        margin: 0 0 0.4rem;
        font-size: 1.08rem;
        font-weight: 600;
      }

      .post-card p {
        margin: 0.45rem 0;
      }

      .post-meta {
        color: var(--muted);
        font-size: 0.84rem;
      }

      .post-card:nth-child(2n) .post-meta {
        color: color-mix(in srgb, var(--muted) 70%, var(--accent-2) 30%);
      }

      .post-card:nth-child(3n) .post-meta {
        color: color-mix(in srgb, var(--muted) 70%, var(--accent) 30%);
      }

      .empty {
        margin-top: 0;
        color: var(--muted);
      }

      .sigil {
        color: var(--accent);
        margin-right: 0.45rem;
      }

      @media (max-width: 720px) {
        main {
          padding: 1.5rem 0.9rem 3rem;
        }

        .masthead {
          padding: 1.15rem 1rem;
        }

        .masthead::before {
          width: 140px;
          height: 170px;
          top: -10px;
          right: -5px;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(1.45rem, 6.5vw, 2rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="masthead">
        <p class="kicker">
          <svg class="nf-logo" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg" aria-label="NF logo">
            <rect x="0" y="0" width="7" height="52" fill="#ff1744"/>
            <polygon points="0,0 9,0 28,44 28,52 19,52 0,8" fill="#ff1744"/>
            <rect x="23" y="0" width="5" height="52" fill="#ff1744"/>
            <rect x="28" y="0" width="5" height="52" fill="#00e5ff"/>
            <rect x="33" y="0" width="17" height="9" fill="#00e5ff"/>
            <rect x="33" y="22" width="14" height="9" fill="#00e5ff"/>
          </svg>
          noise-floor // journal index
        </p>
        <h1>Field notes for code, systems, and the things that break in interesting ways.</h1>
        <p class="lede">
          A sparse technical journal with clean edges, quiet contrast, and just
          enough green signal in the dark. Source truth stays in the workspace
          until a post is intentionally packaged here.
        </p>
        <p class="meta"><span class="status-dot"></span>status: online · layout: boxed · theme: signal-electric</p>
      </section>

      <p class="section-title">Published Notes</p>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-card">
                <p class="post-meta">
                  <span class="sigil">&gt;</span>
                  {post.data.pubDate?.toISOString().slice(0, 10) ?? "undated"}
                  {post.data.tags.length > 0 && ` // ${post.data.tags.join(" · ")}`}
                </p>
                <h2>
                  <a href={`${baseUrl}blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.thesis && <p class="post-meta">thesis: {post.data.thesis}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No public posts yet.</p>
        )
      }
    </main>
  </body>
</html>
