---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate?.getTime() ?? 0;
    const bTime = b.data.pubDate?.getTime() ?? 0;
    return bTime - aTime;
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>noise-floor</title>
    <meta
      name="description"
      content="Publication target for technical writing packaged from the OpenClaw workspace."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #12161c;
        --bg-top: #1a2029;
        --panel: rgba(25, 31, 39, 0.88);
        --panel-soft: rgba(22, 27, 35, 0.84);
        --border: rgba(126, 145, 168, 0.24);
        --text: #ebeff4;
        --muted: #9eacbc;
        --signal: #8fb8c4;
        --signal-strong: #d7e6eb;
        --signal-dim: #6f8898;
        --warning: #b7c9a8;
        --shadow: rgba(0, 0, 0, 0.28);
        font-family: "Source Serif 4", Georgia, serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22%),
          linear-gradient(180deg, var(--bg-top), var(--bg));
      }

      main {
        max-width: 76rem;
        margin: 0 auto;
        padding: 3.5rem 2rem 6rem;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .masthead {
        margin-bottom: 2.5rem;
        padding: 2rem 2.1rem;
        border: 1px solid var(--border);
        background: var(--panel);
        box-shadow: 0 18px 50px var(--shadow);
        border-radius: 16px;
      }

      .kicker,
      .meta,
      .post-meta,
      .empty {
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .kicker {
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.78rem;
        margin: 0 0 0.75rem;
      }

      h1,
      h2 {
        line-height: 1.1;
      }

      h1 {
        font-size: clamp(2.8rem, 6vw, 5.2rem);
        margin: 0;
        max-width: 16ch;
      }

      .lede {
        max-width: 56rem;
        color: var(--muted);
        font-size: 1.12rem;
        margin: 1.1rem 0 0;
      }

      .meta {
        margin-top: 1.25rem;
        color: var(--muted);
        font-size: 0.86rem;
      }

      .section-title {
        margin: 2rem 0 1rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.84rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
        gap: 1.2rem;
      }

      .post-card {
        padding: 1.2rem 1.25rem 1.25rem;
        border: 1px solid var(--border);
        background: var(--panel-soft);
        border-radius: 16px;
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
      }

      .post-card h2 {
        margin: 0 0 0.4rem;
        font-size: 1.5rem;
      }

      .post-card p {
        margin: 0.45rem 0;
      }

      .post-meta {
        color: var(--muted);
        font-size: 0.84rem;
      }

      .empty {
        margin-top: 0;
        color: var(--muted);
      }

      .sigil {
        color: var(--signal);
        margin-right: 0.45rem;
      }

      @media (max-width: 720px) {
        main {
          padding: 2rem 1rem 4rem;
        }

        .masthead {
          padding: 1.4rem 1.2rem;
          border-radius: 18px;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(2.2rem, 10vw, 3.4rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section class="masthead">
        <p class="kicker">noise-floor // system log</p>
        <h1>Old-school signal, modern build pipeline.</h1>
        <p class="lede">
          Technical notes, failure analysis, and build logs with minimal chrome
          and no marketing lacquer. Source truth stays in the workspace until a
          post is intentionally packaged here.
        </p>
        <p class="meta">status: online · medium: astro · mode: public notebook</p>
      </section>

      <p class="section-title">Published Notes</p>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-card">
                <p class="post-meta">
                  <span class="sigil">&gt;</span>
                  {post.data.pubDate?.toISOString().slice(0, 10) ?? "undated"}
                  {post.data.tags.length > 0 && ` // ${post.data.tags.join(" · ")}`}
                </p>
                <h2>
                  <a href={`${baseUrl}blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.thesis && <p class="post-meta">thesis: {post.data.thesis}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No public posts yet.</p>
        )
      }
    </main>
  </body>
</html>
