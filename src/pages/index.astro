---
import { getCollection } from "astro:content";

const baseUrl = import.meta.env.BASE_URL;
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const aTime = a.data.pubDate?.getTime() ?? 0;
    const bTime = b.data.pubDate?.getTime() ?? 0;
    return bTime - aTime;
  });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>noise-floor</title>
    <meta
      name="description"
      content="Publication target for technical writing packaged from the OpenClaw workspace."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #171b1a;
        --panel: rgba(27, 31, 30, 0.9);
        --grid: rgba(126, 160, 138, 0.08);
        --border: rgba(126, 160, 138, 0.26);
        --text: #e6e4dd;
        --muted: #a6ada6;
        --signal: #9cb6a2;
        --signal-strong: #c4d0c2;
        --signal-dim: #73897b;
        --warning: #c8b585;
        font-family: "Source Serif 4", Georgia, serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          linear-gradient(rgba(84, 255, 159, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(84, 255, 159, 0.04) 1px, transparent 1px),
          radial-gradient(circle at top, rgba(84, 255, 159, 0.14), transparent 38%),
          var(--bg);
        background-size: 24px 24px, 24px 24px, auto, auto;
      }

      main {
        max-width: 58rem;
        margin: 0 auto;
        padding: 3rem 1.5rem 5rem;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .masthead {
        margin-bottom: 2rem;
        padding: 1rem 1.2rem;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(7, 20, 15, 0.96), rgba(7, 20, 15, 0.76));
        box-shadow: 0 0 0 1px rgba(84, 255, 159, 0.05), 0 18px 60px rgba(0, 0, 0, 0.35);
      }

      .kicker,
      .meta,
      .post-meta,
      .empty {
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .kicker {
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.78rem;
        margin: 0 0 0.75rem;
      }

      h1,
      h2 {
        line-height: 1.1;
      }

      h1 {
        font-size: clamp(2.4rem, 7vw, 4.6rem);
        margin: 0;
        max-width: 12ch;
      }

      .lede {
        max-width: 52rem;
        color: var(--muted);
        font-size: 1.05rem;
        margin: 1rem 0 0;
      }

      .meta {
        margin-top: 1.25rem;
        color: var(--warning);
        font-size: 0.86rem;
      }

      .section-title {
        margin: 2rem 0 0.75rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.84rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1rem;
      }

      .post-card {
        padding: 1rem 1.1rem 1.1rem;
        border: 1px solid var(--border);
        background: var(--panel);
      }

      .post-card h2 {
        margin: 0 0 0.4rem;
        font-size: 1.35rem;
      }

      .post-card p {
        margin: 0.45rem 0;
      }

      .post-meta {
        color: var(--muted);
        font-size: 0.84rem;
      }

      .empty {
        margin-top: 0;
        color: var(--muted);
      }

      .sigil {
        color: var(--signal-dim);
        margin-right: 0.45rem;
      }
    </style>
  </head>
  <body>
    <main>
      <section class="masthead">
        <p class="kicker">noise-floor // system log</p>
        <h1>Old-school signal, modern build pipeline.</h1>
        <p class="lede">
          Technical notes, failure analysis, and build logs with minimal chrome
          and no marketing lacquer. Source truth stays in the workspace until a
          post is intentionally packaged here.
        </p>
        <p class="meta">status: online · medium: astro · mode: public notebook</p>
      </section>

      <p class="section-title">Published Notes</p>
      {
        posts.length > 0 ? (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-card">
                <p class="post-meta">
                  <span class="sigil">&gt;</span>
                  {post.data.pubDate?.toISOString().slice(0, 10) ?? "undated"}
                  {post.data.tags.length > 0 && ` // ${post.data.tags.join(" · ")}`}
                </p>
                <h2>
                  <a href={`${baseUrl}blog/${post.slug}/`}>{post.data.title}</a>
                </h2>
                {post.data.description && <p>{post.data.description}</p>}
                {post.data.thesis && <p class="post-meta">thesis: {post.data.thesis}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">No public posts yet.</p>
        )
      }
    </main>
  </body>
</html>
