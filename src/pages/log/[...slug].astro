---
import { fileContent } from "../../content.generated";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import ContentBlocks from "../../components/ContentBlocks.astro";
import { href, readingMinutes, seriesOf, projectOf } from "../../site";

export function getStaticPaths() {
  return fileContent.entries
    .filter((entry) => entry.published && entry.slug)
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const project = projectOf(entry);
const series = seriesOf(entry);
---

<BlogPostLayout
  frontmatter={{
    title: entry.title,
    description: entry.summary,
    pubDate: entry.published_at ? new Date(entry.published_at) : undefined,
    tags: entry.tags,
  }}
  eyebrow={{ label: series ? series.name : "Diary", href: href("/log/") }}
  readingMinutes={readingMinutes(entry.body)}
  project={project ? { name: project.name, slug: project.slug } : undefined}
  series={series ?? undefined}
  feedback
>
  <ContentBlocks kind="log" slug={entry.slug} />
</BlogPostLayout>
