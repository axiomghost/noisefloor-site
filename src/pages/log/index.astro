---
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import EntryCard from "../../components/EntryCard.astro";
import { entries } from "../../site";

const list = entries();
---

<BlogPostLayout
  frontmatter={{
    title: "Diary",
    description: "Notes from the work: experiments, derivations, code, and corrections. Series are kept together in reading order.",
  }}
>
  <ul class="card-list">
    {list.map((entry) => <EntryCard entry={entry} heading="h2" />)}
  </ul>
</BlogPostLayout>
