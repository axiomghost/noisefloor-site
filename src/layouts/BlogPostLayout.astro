---
interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const homeHref = import.meta.env.BASE_URL;

const formatDate = (value?: Date) =>
  value
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(value)
    : null;

const published = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | noise-floor</title>
    {frontmatter.description && (
      <meta name="description" content={frontmatter.description} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #040505;
        --bg-haze: rgba(71, 126, 95, 0.1);
        --bg-haze-2: rgba(92, 132, 118, 0.07);
        --panel: rgba(8, 10, 10, 0.9);
        --border: rgba(89, 122, 104, 0.3);
        --border-strong: rgba(134, 193, 157, 0.36);
        --text: #d8dedb;
        --muted: #8b9891;
        --signal: #86c19d;
        --signal-dim: #5d7f6a;
        --code-bg: rgba(9, 11, 11, 0.96);
        --quote: #78a8a1;
        --accent-2: #7fa9c7;
        --shadow: rgba(0, 0, 0, 0.4);
        font-family: "IBM Plex Mono", "Courier New", monospace;
        line-height: 1.72;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 18% 16%, var(--bg-haze), transparent 22%),
          radial-gradient(circle at 72% 10%, var(--bg-haze-2), transparent 18%),
          radial-gradient(circle at 50% 85%, rgba(120, 168, 161, 0.05), transparent 26%),
          radial-gradient(circle at 78% 76%, rgba(127, 169, 199, 0.055), transparent 18%),
          linear-gradient(120deg, transparent 0%, rgba(134, 193, 157, 0.03) 24%, transparent 48%),
          linear-gradient(60deg, transparent 0%, rgba(120, 168, 161, 0.025) 28%, transparent 52%),
          linear-gradient(28deg, transparent 0%, rgba(127, 169, 199, 0.025) 30%, transparent 54%),
          var(--bg);
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-radial-gradient(
            circle at 15% 20%,
            rgba(134, 193, 157, 0.05) 0 1px,
            transparent 1px 28px
          ),
          repeating-radial-gradient(
            circle at 80% 30%,
            rgba(120, 168, 161, 0.035) 0 1px,
            transparent 1px 34px
          ),
          repeating-radial-gradient(
            circle at 62% 74%,
            rgba(127, 169, 199, 0.028) 0 1px,
            transparent 1px 40px
          );
        filter: blur(14px);
        opacity: 0.52;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 24%, transparent 0 84px, rgba(134, 193, 157, 0.045) 84px 86px, transparent 86px 116px, rgba(134, 193, 157, 0.03) 116px 118px, transparent 118px),
          radial-gradient(circle at 72% 28%, transparent 0 112px, rgba(127, 169, 199, 0.036) 112px 114px, transparent 114px 150px, rgba(127, 169, 199, 0.024) 150px 152px, transparent 152px),
          radial-gradient(circle at 58% 78%, transparent 0 96px, rgba(120, 168, 161, 0.028) 96px 98px, transparent 98px 132px, rgba(120, 168, 161, 0.02) 132px 134px, transparent 134px);
        filter: blur(10px);
        opacity: 0.68;
      }

      main {
        max-width: 88rem;
        margin: 0 auto;
        padding: 2.4rem 2rem 5rem;
        position: relative;
        z-index: 1;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .home {
        margin: 0 0 1.5rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.82rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      header {
        margin-bottom: 2rem;
        padding: 1.2rem 1.3rem 1.25rem;
        border: 1px solid var(--border-strong);
        background:
          linear-gradient(180deg, rgba(10, 12, 12, 0.92), rgba(8, 10, 10, 0.82)),
          var(--panel);
        box-shadow:
          0 18px 46px var(--shadow),
          0 0 0 1px rgba(127, 169, 199, 0.05),
          0 0 24px rgba(134, 193, 157, 0.07);
        border-radius: 0;
      }

      h1 {
        line-height: 1.24;
        margin: 0 0 0.75rem;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        max-width: 28ch;
        color: #b9e0c7;
        font-weight: 600;
      }

      .meta {
        color: var(--muted);
        font-size: 0.82rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .description {
        color: #9db0a4;
        font-size: 0.94rem;
      }

      article {
        padding: 1.4rem 1.35rem 1.7rem;
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(10, 12, 12, 0.92), rgba(8, 10, 10, 0.84)),
          var(--panel);
        border-radius: 0;
        box-shadow:
          0 16px 40px rgba(0, 0, 0, 0.2),
          0 0 18px rgba(134, 193, 157, 0.035);
      }

      article :global(h2),
      article :global(h3) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        line-height: 1.2;
        color: color-mix(in srgb, var(--signal) 78%, var(--accent-2) 22%);
      }

      article :global(code) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-size: 0.92em;
        color: #b9e0c7;
        background: rgba(134, 193, 157, 0.09);
        padding: 0.12rem 0.32rem;
      }

      article :global(pre) {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--code-bg);
      }

      article :global(pre code) {
        background: transparent;
        padding: 0;
      }

      article :global(blockquote) {
        margin: 1.4rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--quote);
        color: #9eb5aa;
      }

      article :global(ul),
      article :global(ol) {
        padding-left: 1.4rem;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed var(--signal-dim);
        margin: 2rem 0;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }

      @media (max-width: 720px) {
        main {
          padding: 1.5rem 0.9rem 3rem;
        }

        header,
        article {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(1.35rem, 6vw, 1.9rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="home"><a href={homeHref}>noise-floor</a></p>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p class="description">{frontmatter.description}</p>}
          {(published || updated || frontmatter.tags?.length) && (
            <p class="meta">
              {published && `Published ${published}`}
              {published && updated && " · "}
              {updated && `Updated ${updated}`}
              {(published || updated) && frontmatter.tags?.length ? " · " : ""}
              {frontmatter.tags?.length ? frontmatter.tags.join(", ") : ""}
            </p>
          )}
        </header>
        <slot />
      </article>
    </main>
  </body>
</html>
