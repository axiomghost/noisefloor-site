---
interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const homeHref = import.meta.env.BASE_URL;

const formatDate = (value?: Date) =>
  value
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(value)
    : null;

const published = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | noise-floor</title>
    {frontmatter.description && (
      <meta name="description" content={frontmatter.description} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #050507;
        --bg-haze: rgba(0, 229, 255, 0.07);
        --bg-haze-2: rgba(255, 51, 102, 0.04);
        --bg-haze-3: rgba(0, 255, 159, 0.035);
        --panel: rgba(8, 8, 14, 0.92);
        --border: rgba(0, 229, 255, 0.16);
        --border-strong: rgba(0, 229, 255, 0.32);
        --text: #e4e8ef;
        --muted: #6b7a8a;
        --signal: #00e5ff;
        --signal-dim: #0099aa;
        --accent: #ff3366;
        --accent-2: #ffaa2c;
        --accent-3: #00ff9f;
        --code-bg: rgba(8, 8, 16, 0.96);
        --quote: #00e5ff;
        --shadow: rgba(0, 0, 0, 0.45);
        font-family: "JetBrains Mono", "Courier New", monospace;
        line-height: 1.72;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 15% 12%, var(--bg-haze), transparent 28%),
          radial-gradient(circle at 75% 8%, var(--bg-haze-2), transparent 22%),
          radial-gradient(circle at 50% 80%, var(--bg-haze-3), transparent 30%),
          radial-gradient(circle at 85% 70%, rgba(255, 170, 44, 0.025), transparent 20%),
          linear-gradient(135deg, transparent 0%, rgba(0, 229, 255, 0.025) 20%, transparent 45%),
          linear-gradient(45deg, transparent 0%, rgba(255, 51, 102, 0.018) 25%, transparent 50%),
          linear-gradient(200deg, transparent 0%, rgba(0, 255, 159, 0.018) 30%, transparent 55%),
          var(--bg);
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-radial-gradient(
            circle at 12% 18%,
            rgba(0, 229, 255, 0.035) 0 1px,
            transparent 1px 30px
          ),
          repeating-radial-gradient(
            circle at 82% 25%,
            rgba(255, 51, 102, 0.022) 0 1px,
            transparent 1px 36px
          ),
          repeating-radial-gradient(
            circle at 55% 72%,
            rgba(0, 255, 159, 0.018) 0 1px,
            transparent 1px 42px
          );
        filter: blur(12px);
        opacity: 0.55;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 22%, transparent 0 80px, rgba(0, 229, 255, 0.035) 80px 82px, transparent 82px 120px, rgba(0, 229, 255, 0.022) 120px 122px, transparent 122px),
          radial-gradient(circle at 75% 30%, transparent 0 100px, rgba(255, 51, 102, 0.025) 100px 102px, transparent 102px 145px, rgba(255, 51, 102, 0.015) 145px 147px, transparent 147px),
          radial-gradient(circle at 55% 75%, transparent 0 90px, rgba(0, 255, 159, 0.022) 90px 92px, transparent 92px 130px, rgba(0, 255, 159, 0.013) 130px 132px, transparent 132px);
        filter: blur(10px);
        opacity: 0.65;
      }

      main {
        max-width: 88rem;
        margin: 0 auto;
        padding: 2.4rem 2rem 5rem;
        position: relative;
        z-index: 1;
      }

      a {
        color: var(--signal);
        text-decoration: none;
        transition: color 0.2s;
      }

      a:hover {
        color: #66ffee;
        text-decoration: underline;
      }

      .home {
        margin: 0 0 1.5rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.82rem;
        font-family: "JetBrains Mono", "Courier New", monospace;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .nf-logo {
        display: inline-block;
        width: 24px;
        height: 28px;
        vertical-align: middle;
      }

      header {
        margin-bottom: 2rem;
        padding: 1.4rem 1.4rem 1.3rem;
        border: 1px solid var(--border-strong);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        box-shadow:
          0 20px 50px var(--shadow),
          0 0 0 1px rgba(0, 229, 255, 0.05),
          0 0 30px rgba(0, 229, 255, 0.05),
          0 0 60px rgba(255, 51, 102, 0.02);
        border-radius: 0;
      }

      h1 {
        font-family: "Space Grotesk", "Arial", sans-serif;
        line-height: 1.24;
        margin: 0 0 0.75rem;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        max-width: 28ch;
        color: #66ffee;
        font-weight: 700;
      }

      .meta {
        color: var(--muted);
        font-size: 0.82rem;
        font-family: "JetBrains Mono", "Courier New", monospace;
      }

      .description {
        color: #8fa8b8;
        font-size: 0.94rem;
      }

      article {
        padding: 1.5rem 1.4rem 1.8rem;
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        border-radius: 0;
        box-shadow:
          0 16px 40px rgba(0, 0, 0, 0.25),
          0 0 20px rgba(0, 229, 255, 0.03);
      }

      article :global(h2),
      article :global(h3) {
        font-family: "Space Grotesk", "Arial", sans-serif;
        line-height: 1.2;
        color: var(--signal);
        font-weight: 600;
      }

      article :global(h2) {
        border-bottom: 1px solid rgba(0, 229, 255, 0.1);
        padding-bottom: 0.4rem;
      }

      article :global(code) {
        font-family: "JetBrains Mono", "Courier New", monospace;
        font-size: 0.92em;
        color: var(--accent-3);
        background: rgba(0, 255, 159, 0.08);
        padding: 0.12rem 0.32rem;
      }

      article :global(pre) {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--code-bg);
      }

      article :global(pre code) {
        background: transparent;
        padding: 0;
        color: var(--text);
      }

      article :global(blockquote) {
        margin: 1.4rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--accent);
        color: #8fa8b8;
      }

      article :global(ul),
      article :global(ol) {
        padding-left: 1.4rem;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed var(--signal-dim);
        margin: 2rem 0;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }

      article :global(strong) {
        color: #fff;
        font-weight: 600;
      }

      @media (max-width: 720px) {
        main {
          padding: 1.5rem 0.9rem 3rem;
        }

        header,
        article {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(1.35rem, 6vw, 1.9rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="home">
        <a href={homeHref}>
          <svg class="nf-logo" viewBox="0 0 50 52" xmlns="http://www.w3.org/2000/svg" aria-label="NF logo">
            <rect x="0" y="0" width="7" height="52" fill="#00e5ff"/>
            <polygon points="0,0 9,0 31,44 31,52 22,52 0,8" fill="#00e5ff"/>
            <rect x="24" y="0" width="7" height="52" fill="#00e5ff"/>
            <rect x="31" y="0" width="19" height="9" fill="#ff3366"/>
            <rect x="31" y="22" width="16" height="9" fill="#ff3366"/>
          </svg>
          noise-floor
        </a>
      </p>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p class="description">{frontmatter.description}</p>}
          {(published || updated || frontmatter.tags?.length) && (
            <p class="meta">
              {published && `Published ${published}`}
              {published && updated && " · "}
              {updated && `Updated ${updated}`}
              {(published || updated) && frontmatter.tags?.length ? " · " : ""}
              {frontmatter.tags?.length ? frontmatter.tags.join(", ") : ""}
            </p>
          )}
        </header>
        <slot />
      </article>
    </main>
  </body>
</html>
