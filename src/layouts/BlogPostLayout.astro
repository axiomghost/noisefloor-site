---
// Pages with a title and prose: posts, project pages, About, Contact, listings.
// Bundled with the page, so KaTeX fonts are served from the site under the base path, not a CDN.
import "katex/dist/katex.min.css";
import SiteLayout from "./SiteLayout.astro";
import { href, tagName, formatDate } from "../site";

interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

interface Link {
  title: string;
  slug: string;
}

interface Props {
  frontmatter: Frontmatter;
  /** Small label above the title; a link when href is given. */
  eyebrow?: { label: string; href?: string };
  readingMinutes?: number;
  project?: { name: string; slug: string };
  series?: { name: string; index: number; parts: Link[]; prev?: Link; next?: Link };
  /** Show the discussion and feedback links (posts only). */
  feedback?: boolean;
  wide?: boolean;
}

const { frontmatter, eyebrow, readingMinutes, project, series, feedback = false, wide = false } =
  Astro.props;
const published = frontmatter.pubDate ? formatDate(frontmatter.pubDate.toISOString()) : null;
const updated = frontmatter.updatedDate ? formatDate(frontmatter.updatedDate.toISOString()) : null;
const tags = frontmatter.tags ?? [];
const hasMeta = published || readingMinutes || project || tags.length > 0;
const issueUrl = `https://github.com/axiomghost/noisefloor-site/issues/new?title=${encodeURIComponent(`Feedback: ${frontmatter.title}`)}`;
---

<SiteLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogType={frontmatter.pubDate ? "article" : "website"}
  publishedTime={frontmatter.pubDate?.toISOString()}
>
  <div class:list={["page", { "page-wide": wide }]}>
    <header>
      {eyebrow && (
        <p class="eyebrow">{eyebrow.href ? <a href={eyebrow.href}>{eyebrow.label}</a> : eyebrow.label}</p>
      )}
      <h1 class="page-title">{frontmatter.title}</h1>
      {frontmatter.description && <p class="page-lede">{frontmatter.description}</p>}

      {hasMeta && (
        <div class="post-meta">
          {published && <time datetime={frontmatter.pubDate?.toISOString()}>{published}</time>}
          {updated && <><span class="sep">·</span><span>Updated {updated}</span></>}
          {readingMinutes && <><span class="sep">·</span><span>{readingMinutes} min read</span></>}
          {project && (
            <><span class="sep">·</span><a href={href(`/projects/${project.slug}/`)}>{project.name}</a></>
          )}
          {tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {tags.map((tag) => (
                <li><a class="tag" href={href(`/tags/${tag}/`)}>{tagName(tag)}</a></li>
              ))}
            </ul>
          )}
        </div>
      )}

      {series && series.parts.length > 1 && (
        <nav class="series-box" aria-label={`Series: ${series.name}`}>
          <p>Part {series.index + 1} of {series.parts.length} in the series <strong>{series.name}</strong></p>
          <ol>
            {series.parts.map((part, i) => (
              <li aria-current={i === series.index ? "page" : undefined}>
                {i === series.index ? part.title : <a href={href(`/log/${part.slug}/`)}>{part.title}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}
    </header>

    <article class="prose">
      <slot />
    </article>

    {series && (series.prev || series.next) && (
      <nav class="pager" aria-label="Series navigation">
        {series.prev && (
          <a class="prev" href={href(`/log/${series.prev.slug}/`)}><small>← Previous in {series.name}</small>{series.prev.title}</a>
        )}
        {series.next && (
          <a class="next" href={href(`/log/${series.next.slug}/`)}><small>Next in {series.name} →</small>{series.next.title}</a>
        )}
      </nav>
    )}

    {feedback && (
      <p class="post-feedback">
        Questions or corrections?
        <a href="https://github.com/axiomghost/noisefloor-site/discussions" rel="noopener">Join the discussion</a>
        <a href={issueUrl} rel="noopener">Report an error</a>
      </p>
    )}
  </div>
</SiteLayout>
