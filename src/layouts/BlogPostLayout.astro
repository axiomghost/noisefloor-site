---
interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const homeHref = import.meta.env.BASE_URL;

const formatDate = (value?: Date) =>
  value
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(value)
    : null;

const published = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | noise-floor</title>
    {frontmatter.description && (
      <meta name="description" content={frontmatter.description} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #12161c;
        --bg-top: #1a2029;
        --panel: rgba(23, 29, 37, 0.92);
        --border: rgba(126, 145, 168, 0.22);
        --text: #ebeff4;
        --muted: #9eacbc;
        --signal: #8fb8c4;
        --signal-dim: #6f8898;
        --code-bg: rgba(17, 22, 28, 0.96);
        --quote: #b7c9a8;
        --shadow: rgba(0, 0, 0, 0.28);
        font-family: "Source Serif 4", Georgia, serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 22%),
          linear-gradient(180deg, var(--bg-top), var(--bg));
      }

      main {
        max-width: 74rem;
        margin: 0 auto;
        padding: 2.8rem 2rem 6rem;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .home {
        margin: 0 0 1.5rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.82rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      header {
        margin-bottom: 2rem;
        padding: 1.5rem 1.7rem 1.6rem;
        border: 1px solid var(--border);
        background: var(--panel);
        box-shadow: 0 18px 48px var(--shadow);
        border-radius: 16px;
      }

      h1 {
        line-height: 1.1;
        margin: 0 0 0.75rem;
        font-size: clamp(2.4rem, 5vw, 4.2rem);
        max-width: 18ch;
      }

      .meta {
        color: var(--muted);
        font-size: 0.9rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .description {
        color: #cad5df;
        font-size: 1.08rem;
      }

      article {
        padding: 2rem 1.8rem 2.2rem;
        border: 1px solid var(--border);
        background: var(--panel);
        border-radius: 16px;
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.18);
      }

      article :global(h2),
      article :global(h3) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        line-height: 1.2;
        color: var(--signal);
      }

      article :global(code) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-size: 0.92em;
        background: rgba(143, 184, 196, 0.1);
        padding: 0.12rem 0.32rem;
      }

      article :global(pre) {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--code-bg);
      }

      article :global(pre code) {
        background: transparent;
        padding: 0;
      }

      article :global(blockquote) {
        margin: 1.4rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--quote);
        color: #d8d1b1;
      }

      article :global(ul),
      article :global(ol) {
        padding-left: 1.4rem;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed var(--signal-dim);
        margin: 2rem 0;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }

      @media (max-width: 720px) {
        main {
          padding: 2rem 1rem 4rem;
        }

        header,
        article {
          padding-left: 1.2rem;
          padding-right: 1.2rem;
          border-radius: 18px;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(2.1rem, 10vw, 3.3rem);
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="home"><a href={homeHref}>noise-floor</a></p>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p class="description">{frontmatter.description}</p>}
          {(published || updated || frontmatter.tags?.length) && (
            <p class="meta">
              {published && `Published ${published}`}
              {published && updated && " · "}
              {updated && `Updated ${updated}`}
              {(published || updated) && frontmatter.tags?.length ? " · " : ""}
              {frontmatter.tags?.length ? frontmatter.tags.join(", ") : ""}
            </p>
          )}
        </header>
        <slot />
      </article>
    </main>
  </body>
</html>
