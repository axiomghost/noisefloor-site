---
interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const homeHref = import.meta.env.BASE_URL;

const formatDate = (value?: Date) =>
  value
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(value)
    : null;

const published = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | noise-floor</title>
    {frontmatter.description && (
      <meta name="description" content={frontmatter.description} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #171b1a;
        --panel: rgba(27, 31, 30, 0.92);
        --border: rgba(126, 160, 138, 0.24);
        --grid: rgba(126, 160, 138, 0.08);
        --text: #e6e4dd;
        --muted: #a6ada6;
        --signal: #9cb6a2;
        --signal-dim: #73897b;
        --code-bg: rgba(20, 24, 23, 0.94);
        --quote: #c8b585;
        font-family: "Source Serif 4", Georgia, serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          linear-gradient(rgba(84, 255, 159, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(84, 255, 159, 0.04) 1px, transparent 1px),
          radial-gradient(circle at top, rgba(84, 255, 159, 0.12), transparent 36%),
          var(--bg);
        background-size: 24px 24px, 24px 24px, auto, auto;
      }

      main {
        max-width: 58rem;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 5rem;
      }

      a {
        color: var(--signal);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .home {
        margin: 0 0 1.5rem;
        color: var(--signal);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.82rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      header {
        margin-bottom: 2rem;
        padding: 1rem 1.2rem 1.25rem;
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(7, 20, 15, 0.96), rgba(7, 20, 15, 0.78));
        box-shadow: 0 0 0 1px rgba(84, 255, 159, 0.05), 0 18px 60px rgba(0, 0, 0, 0.32);
      }

      h1 {
        line-height: 1.1;
        margin: 0 0 0.75rem;
        font-size: clamp(2rem, 6vw, 3.6rem);
      }

      .meta {
        color: var(--muted);
        font-size: 0.9rem;
        font-family: "IBM Plex Mono", "Courier New", monospace;
      }

      .description {
        color: #bfd0c0;
        font-size: 1.04rem;
      }

      article {
        padding: 1.5rem 1.2rem 2rem;
        border: 1px solid var(--border);
        background: var(--panel);
      }

      article :global(h2),
      article :global(h3) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        line-height: 1.2;
        color: var(--signal);
      }

      article :global(code) {
        font-family: "IBM Plex Mono", "Courier New", monospace;
        font-size: 0.92em;
        background: rgba(156, 182, 162, 0.1);
        padding: 0.12rem 0.32rem;
      }

      article :global(pre) {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--code-bg);
      }

      article :global(pre code) {
        background: transparent;
        padding: 0;
      }

      article :global(blockquote) {
        margin: 1.4rem 0;
        padding-left: 1rem;
        border-left: 3px solid var(--quote);
        color: #d8d1b1;
      }

      article :global(ul),
      article :global(ol) {
        padding-left: 1.4rem;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed var(--signal-dim);
        margin: 2rem 0;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="home"><a href={homeHref}>noise-floor</a></p>
      <article>
        <header>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p class="description">{frontmatter.description}</p>}
          {(published || updated || frontmatter.tags?.length) && (
            <p class="meta">
              {published && `Published ${published}`}
              {published && updated && " · "}
              {updated && `Updated ${updated}`}
              {(published || updated) && frontmatter.tags?.length ? " · " : ""}
              {frontmatter.tags?.length ? frontmatter.tags.join(", ") : ""}
            </p>
          )}
        </header>
        <slot />
      </article>
    </main>
  </body>
</html>
