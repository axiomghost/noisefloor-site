---
interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const homeHref = import.meta.env.BASE_URL;

const formatDate = (value?: Date) =>
  value
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(value)
    : null;

const published = formatDate(frontmatter.pubDate);
const updated = formatDate(frontmatter.updatedDate);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | noise-floor</title>
    {frontmatter.description && (
      <meta name="description" content={frontmatter.description} />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --bg: #050507;
        --bg-haze: rgba(0, 229, 255, 0.07);
        --bg-haze-2: rgba(255, 51, 102, 0.04);
        --bg-haze-3: rgba(0, 255, 159, 0.035);
        --panel: rgba(8, 8, 14, 0.92);
        --border: rgba(0, 229, 255, 0.16);
        --border-strong: rgba(0, 229, 255, 0.32);
        --text: #d6dae2;
        --muted: #6b7a8a;
        --signal: #00e5ff;
        --signal-dim: #0099aa;
        --accent: #ff1744;
        --accent-2: #ffaa2c;
        --accent-3: #00ff9f;
        --code-bg: rgba(8, 8, 16, 0.96);
        --shadow: rgba(0, 0, 0, 0.45);
        font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
        line-height: 1.78;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        background:
          radial-gradient(circle at 15% 12%, var(--bg-haze), transparent 28%),
          radial-gradient(circle at 75% 8%, var(--bg-haze-2), transparent 22%),
          radial-gradient(circle at 50% 80%, var(--bg-haze-3), transparent 30%),
          radial-gradient(circle at 85% 70%, rgba(255, 170, 44, 0.025), transparent 20%),
          linear-gradient(135deg, transparent 0%, rgba(0, 229, 255, 0.025) 20%, transparent 45%),
          linear-gradient(45deg, transparent 0%, rgba(255, 51, 102, 0.018) 25%, transparent 50%),
          linear-gradient(200deg, transparent 0%, rgba(0, 255, 159, 0.018) 30%, transparent 55%),
          var(--bg);
        position: relative;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-radial-gradient(
            circle at 12% 18%,
            rgba(0, 229, 255, 0.035) 0 1px,
            transparent 1px 30px
          ),
          repeating-radial-gradient(
            circle at 82% 25%,
            rgba(255, 51, 102, 0.022) 0 1px,
            transparent 1px 36px
          ),
          repeating-radial-gradient(
            circle at 55% 72%,
            rgba(0, 255, 159, 0.018) 0 1px,
            transparent 1px 42px
          );
        filter: blur(12px);
        opacity: 0.55;
      }

      body::after {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(circle at 18% 22%, transparent 0 80px, rgba(0, 229, 255, 0.035) 80px 82px, transparent 82px 120px, rgba(0, 229, 255, 0.022) 120px 122px, transparent 122px),
          radial-gradient(circle at 75% 30%, transparent 0 100px, rgba(255, 51, 102, 0.025) 100px 102px, transparent 102px 145px, rgba(255, 51, 102, 0.015) 145px 147px, transparent 147px),
          radial-gradient(circle at 55% 75%, transparent 0 90px, rgba(0, 255, 159, 0.022) 90px 92px, transparent 92px 130px, rgba(0, 255, 159, 0.013) 130px 132px, transparent 132px);
        filter: blur(10px);
        opacity: 0.65;
      }

      /* Top nav bar */
      .topbar {
        position: relative;
        z-index: 2;
        border-bottom: 1px solid var(--signal);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.96), rgba(6, 6, 12, 0.9));
        padding: 0.7rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(0, 229, 255, 0.04);
      }

      .topbar a {
        color: var(--signal);
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: 0.82rem;
        font-family: "JetBrains Mono", "Courier New", monospace;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: color 0.2s;
      }

      .topbar a:hover {
        color: #66ffee;
      }

      .nf-logo {
        display: inline-block;
        width: 22px;
        height: 26px;
        vertical-align: middle;
      }

      /* Two-column layout */
      main {
        max-width: 62rem;
        margin: 0 auto;
        padding: 2.4rem 2rem 3rem;
        position: relative;
        z-index: 1;
      }

      .post-header {
        margin-bottom: 2rem;
        padding: 1.4rem 1.4rem 1.3rem;
        border: 1px solid var(--border-strong);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        box-shadow:
          0 20px 50px var(--shadow),
          0 0 0 1px rgba(0, 229, 255, 0.05),
          0 0 30px rgba(0, 229, 255, 0.05);
        border-radius: 0;
      }

      h1 {
        font-family: "Space Grotesk", "Arial", sans-serif;
        line-height: 1.24;
        margin: 0 0 0.75rem;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        max-width: 28ch;
        color: #c9a96e;
        font-weight: 700;
      }

      .description {
        color: #8fa8b8;
        font-size: 0.94rem;
      }

      .two-col {
        display: grid;
        grid-template-columns: 13rem 1fr;
        gap: 1.5rem;
        align-items: start;
      }

      /* Sidebar */
      .sidebar {
        position: sticky;
        top: 2rem;
        padding: 1.2rem 1rem;
        border: 1px solid var(--border);
        border-top: 1px solid var(--signal);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        font-size: 0.8rem;
      }

      .sidebar-label {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.7rem;
        margin: 0 0 0.4rem;
      }

      .sidebar-label:not(:first-child) {
        margin-top: 1.2rem;
      }

      .sidebar-value {
        color: var(--text);
        margin: 0 0 0.15rem;
        font-size: 0.8rem;
      }

      .sidebar-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .sidebar-tags li {
        padding: 0.15rem 0.45rem;
        background: rgba(0, 229, 255, 0.08);
        border: 1px solid rgba(0, 229, 255, 0.15);
        color: var(--signal);
        font-size: 0.72rem;
        letter-spacing: 0.03em;
      }

      /* Article content */
      article {
        padding: 1.5rem 1.6rem 1.8rem 1.8rem;
        border: 1px solid var(--border);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        border-radius: 0;
        box-shadow:
          0 16px 40px rgba(0, 0, 0, 0.25),
          0 0 20px rgba(0, 229, 255, 0.03);
        font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
        font-size: 0.94rem;
        line-height: 1.82;
      }

      a {
        color: var(--signal);
        text-decoration: none;
        transition: color 0.2s;
      }

      a:hover {
        color: #66ffee;
        text-decoration: underline;
      }

      article :global(h2),
      article :global(h3) {
        font-family: "Space Grotesk", "Arial", sans-serif;
        line-height: 1.2;
        color: #c9a96e;
        font-weight: 600;
      }

      article :global(h2) {
        border-bottom: 1px solid rgba(201, 169, 110, 0.15);
        padding-bottom: 0.4rem;
      }

      article :global(code) {
        font-family: "JetBrains Mono", "Courier New", monospace;
        font-size: 0.88em;
        color: var(--accent-3);
        background: rgba(0, 255, 159, 0.08);
        padding: 0.12rem 0.32rem;
      }

      article :global(pre) {
        overflow-x: auto;
        padding: 1rem;
        border: 1px solid var(--border);
        background: var(--code-bg);
      }

      article :global(pre code) {
        background: transparent;
        padding: 0;
        color: var(--text);
      }

      article :global(blockquote) {
        margin: 1.4rem 0;
        padding-left: 1rem;
        border-left: 1px solid rgba(201, 169, 110, 0.3);
        color: #8fa8b8;
      }

      article :global(ul),
      article :global(ol) {
        padding-left: 1.4rem;
      }

      article :global(hr) {
        border: 0;
        border-top: 1px dashed var(--signal-dim);
        margin: 2rem 0;
      }

      article :global(img) {
        max-width: 100%;
        height: auto;
      }

      article :global(strong) {
        color: #e8e4de;
        font-weight: 600;
      }

      /* Contact / feedback footer */
      .post-footer {
        margin-top: 1.5rem;
        padding: 1.2rem 1.4rem;
        border: 1px solid var(--border);
        border-top: 1px solid var(--signal);
        background:
          linear-gradient(180deg, rgba(8, 8, 14, 0.94), rgba(6, 6, 12, 0.86)),
          var(--panel);
        grid-column: 1 / -1;
      }

      .post-footer-title {
        font-family: "Space Grotesk", "Arial", sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--signal);
        margin: 0 0 0.8rem;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.2rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-links li a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--border);
        background: rgba(0, 229, 255, 0.04);
        color: var(--text);
        font-size: 0.78rem;
        transition: border-color 0.2s, background 0.2s;
      }

      .footer-links li a:hover {
        border-color: var(--border-strong);
        background: rgba(0, 229, 255, 0.08);
        text-decoration: none;
        color: var(--signal);
      }

      .footer-icon {
        width: 14px;
        height: 14px;
        opacity: 0.7;
      }

      @media (max-width: 720px) {
        .topbar {
          padding: 0.6rem 1rem;
        }

        main {
          padding: 1.5rem 0.9rem 3rem;
        }

        .two-col {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
          border-top: 1px solid var(--signal);
        }

        article {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(1.35rem, 6vw, 1.9rem);
        }
      }
    </style>
  </head>
  <body>
    <nav class="topbar">
      <a href={homeHref}>
        <svg class="nf-logo" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg" aria-label="NF logo">
          <rect x="0" y="0" width="7" height="52" fill="#00e5ff"/>
          <polygon points="0,0 9,0 28,44 28,52 19,52 0,8" fill="#00e5ff"/>
          <rect x="23" y="0" width="5" height="52" fill="#00e5ff"/>
          <rect x="28" y="0" width="5" height="52" fill="#ff1744"/>
          <rect x="33" y="0" width="17" height="9" fill="#ff1744"/>
          <rect x="33" y="22" width="14" height="9" fill="#ff1744"/>
        </svg>
        noise-floor
      </a>
    </nav>
    <main>
      <div class="post-header">
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="description">{frontmatter.description}</p>}
      </div>

      <div class="two-col">
        <aside class="sidebar">
          {published && (
            <>
              <p class="sidebar-label">Published</p>
              <p class="sidebar-value">{published}</p>
            </>
          )}
          {updated && (
            <>
              <p class="sidebar-label">Updated</p>
              <p class="sidebar-value">{updated}</p>
            </>
          )}
          {frontmatter.tags && frontmatter.tags.length > 0 && (
            <>
              <p class="sidebar-label">Tags</p>
              <ul class="sidebar-tags">
                {frontmatter.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </>
          )}
        </aside>

        <article>
          <slot />
        </article>

        <footer class="post-footer">
          <p class="post-footer-title">Got thoughts?</p>
          <ul class="footer-links">
            <li>
              <a href="https://github.com/axiomghost/noisefloor-site/discussions" target="_blank" rel="noopener">
                <svg class="footer-icon" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.5 8a6.5 6.5 0 1 0 3.25-5.63l-.03.02A6.5 6.5 0 0 0 1.5 8Zm3.25 6.5a8 8 0 1 1 4.75-1.54l-3.19.96a1 1 0 0 1-1.22-1.22l.96-3.19A8 8 0 0 1 4.75 14.5Z"/>
                </svg>
                Join the discussion
              </a>
            </li>
            <li>
              <a href="https://github.com/axiomghost/noisefloor-site/issues/new?title=Feedback:+{frontmatter.title}" target="_blank" rel="noopener">
                <svg class="footer-icon" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"/>
                  <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z"/>
                </svg>
                Leave feedback
              </a>
            </li>
            <li>
              <a href="https://github.com/axiomghost" target="_blank" rel="noopener">
                <svg class="footer-icon" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 0c4.42 0 8 3.58 8 8a8.01 8.01 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
                </svg>
                GitHub
              </a>
            </li>
          </ul>
        </footer>
      </div>
    </main>
  </body>
</html>
